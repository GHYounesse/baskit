# Production environment for Baskit. Copy to ".env" ON THE SERVER (next to compose.yaml)
# and replace every CHANGE_ME.

# Image ---- Set by deploy.sh on every deploy (the git SHA of the image to run).
IMAGE_TAG=latest

# --- Application ---------------------------------------------------------------------------
APP_NAME=Baskit
APP_ENV=production
APP_DEBUG=false
APP_URL=https://shop.younesghalloum.dev
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Cache config/routes/views when a container starts (see docker/entrypoint.sh).
RUN_OPTIMIZE=true

# The host's Nginx reaches the app through the web container
TRUSTED_PROXIES=*

# --- Logging -------------------------------------------------------------------------------
# Logs go to the container output: read them with "docker compose logs".
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (PostgreSQL 16, the "db" service) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=baskit
DB_USERNAME=baskit
DB_PASSWORD=CHANGE_ME

# --- Sessions, cache, queue (all stored in the database; no Redis) --------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Stripe: TEST mode only ----------------------------------------------------------------
# Keys from https://dashboard.stripe.com/test/apikeys (pk_test_... and sk_test_...).
STRIPE_KEY=pk_test_CHANGE_ME
STRIPE_SECRET=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Mail ----------------------------------------------------------------------------------
# SMTP (Resend)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_CHANGE_ME
MAIL_FROM_ADDRESS=hello@younesghalloum.dev
MAIL_FROM_NAME=Baskit
